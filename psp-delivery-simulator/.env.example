# Copy these names into .env.local and fill using Supabase Dashboard > Project Settings > API.
# Publishable key and Project URL are client-visible configuration, not secrets.
# NEVER put a service-role / sb_secret_* key or database password here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key
